# config F=20 T=10 tie=first th_round=floor sd_lut_K=10 pte_lut_Kr=23 pte_lut_L=17 pte_lut_B=8,10 omega=15/16 gamma=2 active0=T_h:128,A_F:FF.FF.FF,A_N:FF.FF.FF,measured:0
# encoding 文字 hex（大寫）、單一空白分隔、每欄固定位數、UTF-8、LF；signed 欄是 4×digits bit 的二補數；invalid 欄寫成全 F（全 F 不在合法範圍內）；以 # 開頭的是檔頭
# frame 00 SA21 21x21：21×21 隨機 0–255
# frame 01 SB2017 20x17：20×17 隨機 1–255；(18,15) = (1,2,3)；(19,15)、(18,16) = 250
# frame 02 C120 9x9：9×9 單色 (120,130,140)
# frame 03 D13 13x13：13×13 案例 d（並列）
# frame 04 E15 15x15：15×15 單色 (50,60,70)，降採樣 (2,2) = (0,90,90)
# frame 05 C123 9x9：9×9 單色 (123,130,140)
# frame 06 C127 9x9：9×9 單色 (127,130,140)
# frame 07 G130 9x9：9×9 單色 (130,130,130)
# frame 08 B100 9x9：9×9 單色 (100,110,120)
# frame 09 X15 15x9：15×9 兩區：列 0–5 = Q (60,70,80)、列 6–14 = P (120,125,130)
# frame 0A RND21 21x21：21×21：列 0–11 隨機 140–255、列 12–20 隨機 0–255
# case 30 ST-A：21×21 隨機（降採樣 7×7，5×5 視窗內部；T_h = oracle dark 的中位數）（來源：ate_golden 案例 a 的作法（本檔 seed 20261110））
# case 31 ST-B：20×17 隨機（尾端：降採樣 7×6；角落視窗補 255）（來源：ate_golden 案例 b 的作法（縮成 21 以內，本檔 seed 20261110））
# case 32 ST-C：dark 恰好等於 T_h → 歸遠群；近群為空（來源：ate_golden 案例 c）
# case 33 ST-D：遠群兩點並列最大，取 raster 第一個（來源：ate_golden 案例 d）
# case 34 ST-E：近群最大 dark 為 0（仍 valid）；遠群為空（來源：ate_golden 案例 e）
# case 35 ST-F：遠群為空（dark 120 < 121）（來源：ate_golden 案例 f）
# case 50 VS2：video：近群差 3／差 4（9×9 單色 × 4）（來源：ate_golden 排程 S2）
# case 51 VS3：video：遠群變空、近群逐張收斂（9×9 單色 × 6）（來源：ate_golden 排程 S3）
# case 52 VX15：video：兩區 15×9 × 7（兩群都有、近群 step 4 收斂）（來源：ate_golden 排程 S6 的 A 序列（影像縮成 15×9，T_h 手算 103））
# case 53 SS4：static：9×9 單色（A = I → 輸出 = 輸入）（來源：ate_golden 排程 S4）
# case 54 SX15：static：兩區 15×9（第一次讀取用 active0 的 T_h 128 分群）（來源：ate_golden 排程 S5 的觀念（影像縮成 15×9））
# case 55 SRND：static：21×21 上方亮區＋下方隨機（兩群都有，PALA 混合）（來源：本檔合成（seed 20261110））
# field stats_id digits=2 bits=8 signed=0 min=0 max=254 invalid=- scale=- : 統計 pass 編號（stats.hex）
# field case_id digits=2 bits=8 signed=0 min=0 max=254 invalid=- scale=- : 案例編號（檔頭的 case 行）
# field seq digits=2 bits=8 signed=0 min=0 max=254 invalid=FF/none scale=- : 排程中的 frame 順序（0 起；靜態排程只有 0）；單元案例為全 F
# field frame_id digits=2 bits=8 signed=0 min=0 max=254 invalid=- scale=- : 影像編號（frames.hex 檔頭的 frame 行）
# field t_h_prev digits=2 bits=8 signed=0 min=0 max=255 invalid=- scale=1 : 分群用的 T_h
# field H digits=3 bits=12 signed=0 min=1 max=1080 invalid=- scale=1 : 原圖列數
# field W digits=3 bits=12 signed=0 min=1 max=1920 invalid=- scale=1 : 原圖行數
# field Hd digits=3 bits=12 signed=0 min=1 max=360 invalid=- scale=1 : 降採樣列數 ceil(H/3)
# field Wd digits=3 bits=12 signed=0 min=1 max=640 invalid=- scale=1 : 降採樣行數 ceil(W/3)
# field N digits=5 bits=20 signed=0 min=1 max=230400 invalid=- scale=1 : 降採樣點數 Hd·Wd
# field gray_sum digits=7 bits=28 signed=0 min=0 max=176256000 invalid=- scale=1 : 降採樣點 R + G + B 的總和（28 bit 可容納 1080p 的 176256000）
# field gray_mean digits=2 bits=8 signed=0 min=0 max=255 invalid=- scale=1 : floor(gray_sum / (3N))
# field far_valid digits=1 bits=4 signed=0 min=0 max=1 invalid=- scale=- : 遠群是否有點（0 = 空群組）
# field far_count digits=5 bits=20 signed=0 min=0 max=230400 invalid=- scale=1 : 遠群的點數
# field far_max digits=3 bits=12 signed=0 min=0 max=255 invalid=FFF/none scale=1 : 遠群的最大 dark；空群組全 F
# field far_i digits=3 bits=12 signed=0 min=0 max=359 invalid=FFF/none scale=- : 所選點的降採樣列（並列取 raster 第一個）；空群組全 F
# field far_j digits=3 bits=12 signed=0 min=0 max=639 invalid=FFF/none scale=- : 所選點的降採樣行；空群組全 F
# field far_R digits=3 bits=12 signed=0 min=0 max=255 invalid=FFF/none scale=1 : 所選點的 R；無效時全 F
# field far_G digits=3 bits=12 signed=0 min=0 max=255 invalid=FFF/none scale=1 : 所選點的 G；無效時全 F
# field far_B digits=3 bits=12 signed=0 min=0 max=255 invalid=FFF/none scale=1 : 所選點的 B；無效時全 F
# field near_valid digits=1 bits=4 signed=0 min=0 max=1 invalid=- scale=- : 近群是否有點（0 = 空群組）
# field near_count digits=5 bits=20 signed=0 min=0 max=230400 invalid=- scale=1 : 近群的點數
# field near_max digits=3 bits=12 signed=0 min=0 max=255 invalid=FFF/none scale=1 : 近群的最大 dark；空群組全 F
# field near_i digits=3 bits=12 signed=0 min=0 max=359 invalid=FFF/none scale=- : 所選點的降採樣列（並列取 raster 第一個）；空群組全 F
# field near_j digits=3 bits=12 signed=0 min=0 max=639 invalid=FFF/none scale=- : 所選點的降採樣行；空群組全 F
# field near_R digits=3 bits=12 signed=0 min=0 max=255 invalid=FFF/none scale=1 : 所選點的 R；無效時全 F
